from typing import Dict, List, Union, Optional

import psqlgraph

from . import utils, versioning


class {{ meta.class_name }}(psqlgraph.Node):
    __tablename__: str = "{{ meta.table_name }}"

    _dictionary: Dict[str, Union[bool, str, List[str]]] = {{ meta.dictionary }}

    _pg_backrefs: Optional[Dict[str, Dict[str, Union[str, psqlgraph.Node]]]] = None
    _pg_edges: Optional[Dict[str, Dict[str, Union[str, psqlgraph.Node]]]] = None
    _pg_links: Optional[Dict[str, Dict[str, Union[str, psqlgraph.Node]]]] = None

{% if meta.tag_props %}
    tag_properties: List[str] = {{ meta.tag_props }}
    # Tagging configuration instance used for checking if node instance participates in versioning
    tag_builder_config: versioning.TagBuilderConfig = versioning.TagBuilderConfig(cfg={{ meta.tag_config }})

    @property
    def tag(self) -> str:
        """Unique identifier for a group of nodes that are part of the same version family.

        Tags are generated when a node is saved.
        They can be manually created using an external script

        Returns:
            str: tag value
        """
        return self._sysan.get("tag")

    @property
    def ver(self) -> int:
        """node version number based on tagging.

        versions are computed during save or via an external script

        Returns:
            int: version number
        """
        return self._sysan.get("ver")

    @property
    def is_latest(self) -> bool:
        """latest version of the node based on tagging

        Returns:
            bool: True if it's the latest version otherwise false
        """
        return self._sysan.get("latest", False)

    def is_taggable(self) -> bool:
        """Returns True if a node instance can be tagged and versioned

        Returns:
            bool: True if node can be tagged
        """
        return self.tag_builder_config.is_taggable(self)

{% endif %}

    @property
    def id(self):
        return self.node_id

    @id.setter
    def id(self, value):
        self.node_id = value

    @classmethod
    def post_process(cls) -> None:
        cls.populate_pg_backrefs()
        cls.populate_pg_links()
        cls.populate_pg_edges()

    @classmethod
    def populate_pg_backrefs(cls) -> None:
        """_pg_backrefs are in_edges, links FROM other types."""
        cls._pg_backrefs = {
            {% for key, value in meta.backrefs_metadata.items() %}
                "{{ key }}": {
                    "name": "{{ value.name }}",
                    "src_type": psqlgraph.Node.get_subclass("{{ value.src_type }}"),
                },
            {% endfor %}
        }

    @classmethod
    def populate_pg_edges(cls) -> None:
        """_pg_edges are all edges, links to AND from other types."""
        cls._pg_edges = {
            {% for key, value in meta.edges_metadata.items() %}
                "{{ key }}": {
                    "backref": "{{ value.backref }}",
                    "type": psqlgraph.Node.get_subclass("{{ value.type }}"),
                },
            {% endfor %}
        }

    @classmethod
    def populate_pg_links(cls) -> None:
        """_pg_links are out_edges, links TO other types."""
        cls._pg_links = {
            {% for key, value in meta.links_metadata.items() %}
                "{{ key }}": {
                    "edge_out": "{{ value.edges_out }}",
                    "dst_type": psqlgraph.Node.get_subclass("{{ value.dst_type }}"),
                },
            {% endfor %}
        }


    @property
    def _default(self) -> Dict[str, Union[bool, float, int, str]]:
        return {{ meta.defaults }}

    @property
    def label(self) -> str:
        return "{{ meta.label }}"

    @property
    def _related_cases_from_cache(self) -> List[psqlgraph.Node]:
        return utils.get_related_cases_from_cache(self)

    @property
    def _related_cases_from_parents(self) -> List[psqlgraph.Node]:
        return utils.get_related_cases_from_parents(self)

    {% for prop in meta.properties %}

    @psqlgraph.pg_property({% for p in prop.types[0] %}{{ p }}{% if not loop.last %},{% endif %} {% endfor %}{% if prop.types[1] %}, enum={{ prop.types[1] }}{% endif %})
    def {{ prop.name }}(self, value):
        self._set_property("{{ prop.name }}", value)  # type: ignore  # inherited from CommonBase

    {% endfor %}
